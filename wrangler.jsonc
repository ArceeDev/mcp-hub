{
  // Web estática + API (/api/*) + MCP remotos con OAuth en Cloudflare Workers. Build: python3 build.py
  "name": "mcp-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // CIMD: el servidor OAuth descarga metadatos de clientes; solo a IPs públicas.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/authorize", "/oauth/*", "/.well-known/oauth-*", "/*/mcp", "/*/mcp/*"]
  },
  "vars": { "GATEWAY_URL": "https://licenses.keyflint.dev", "PUBLIC_ORIGIN": "https://mcp.keyflint.dev" },
  // Tokens, clientes y licencias (cifradas) de OAuth. Crear con: npx wrangler kv namespace create OAUTH_KV
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_ID" }],
  // Los 5 MCP en Python, en un contenedor (requiere el plan Workers Paid).
  "containers": [{ "class_name": "McpRuntime", "image": "./container/Dockerfile", "max_instances": 5, "instance_type": "basic" }],
  "durable_objects": { "bindings": [{ "name": "MCP_RUNTIME", "class_name": "McpRuntime" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["McpRuntime"] }],
  "observability": { "enabled": true }
}
